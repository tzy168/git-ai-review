{
    "name": "git-ai-review",
    "displayName": "Git AI Review",
    "description": "Compare git branches with AI-powered code review (DeepSeek)",
    "version": "1.0.0",
    "publisher": "your-name",
    "engines": {
      "vscode": "^1.80.0"
    },
    "categories": ["Other"],
    "keywords": ["git", "review", "ai", "deepseek", "diff", "cursor"],
    "main": "./out/extension.js",
    "activationEvents": [
      "onCommand:git-ai-review.start",
      "onCommand:git-ai-review.openSettings"
    ],
    "contributes": {
      "commands": [
        {
          "command": "git-ai-review.start",
          "title": "Git AI Review: Compare & Review Branch"
        },
        {
          "command": "git-ai-review.openSettings",
          "title": "Git AI Review: Open Settings"
        }
      ],
      "menus": {
        "commandPalette": [
          { "command": "git-ai-review.start" },
          { "command": "git-ai-review.openSettings" }
        ]
      },
      "configuration": {
        "title": "Git AI Review",
        "properties": {
          "git-ai-review.deepseekApiKey": {
            "type": "string",
            "default": "",
            "description": "DeepSeek API Key (sk-xxx)"
          },
          "git-ai-review.deepseekBaseUrl": {
            "type": "string",
            "default": "https://api.deepseek.com",
            "description": "DeepSeek API Base URL"
          },
          "git-ai-review.model": {
            "type": "string",
            "default": "deepseek-chat",
            "enum": ["deepseek-v4-pro", "deepseek-v4-flash", "deepseek-chat", "deepseek-coder", "deepseek-reasoner"],
            "description": "使用的模型"
          },
          "git-ai-review.language": {
            "type": "string",
            "default": "中文",
            "enum": ["中文", "English"],
            "description": "报告语言"
          },
          "git-ai-review.maxCharsPerChunk": {
            "type": "number",
            "default": 50000,
            "description": "单次发送给 LLM 的最大字符数（超出自动分块）"
          },
          "git-ai-review.reportOutputDir": {
            "type": "string",
            "default": "",
            "description": "报告输出目录（默认为工作区根目录）"
          }
        }
      }
    },
    "scripts": {
      "compile": "tsc -p ./",
      "watch": "tsc -watch -p ./",
      "lint": "eslint src --ext ts",
      "package": "vsce package",
      "pretest": "npm run compile"
    },
    "devDependencies": {
      "@types/node": "^20.11.0",
      "@types/vscode": "^1.80.0",
      "typescript": "^5.3.0",
      "@vscode/vsce": "^2.22.0"
    },
    "dependencies": {
      "openai": "^4.70.0",
      "simple-git": "^3.27.0"
    }
  }
  